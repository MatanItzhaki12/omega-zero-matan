+inline void Sync2D(u32 lane)
+{
+    if (Omega2DDone[lane].load(std::memory_order_acquire) != Omega2DQueued[lane].load(std::memory_order_relaxed))
+        Omega2DWait(lane);
+}
+
+inline void Sync2D()
+{
+    Sync2D(0);
+    Sync2D(1);
+}
