+// omega-zero: each 2D engine draws on a thread of its own, a line or so behind the emulation:
+// lane 0 for engine A, lane 1 for engine B (Omega2D in GPU.cpp). What an engine reads (its
+// registers, its half of the palette and OAM, the VRAM mapped to it, the framebuffers) changes
+// only after Sync2D for its lane, which waits out the lines queued before it: so each line is
+// drawn from the state it had when the emulation reached it, as if drawn there.
+extern bool Omega2DThreaded;
+extern std::atomic<u32> Omega2DQueued[2];
+extern std::atomic<u32> Omega2DDone[2];
+void Omega2DWait(u32 lane);
+void Omega2DStop();
+
+inline void Sync2D(u32 lane)
+{
+    if (Omega2DDone[lane].load(std::memory_order_acquire) != Omega2DQueued[lane].load(std::memory_order_relaxed))
+        Omega2DWait(lane);
+}
+
+inline void Sync2D()
+{
+    Sync2D(0);
+    Sync2D(1);
+}
+
+// the VCount of the line the 2D renderer draws, on whichever thread draws it
+extern thread_local u32 RenderVCount;
+
+// Each engine's sprites are drawn from a copy of its half of the OAM, handed its lane in the
+// queue with the lines that follow a write (Omega2DRun): an OAM write waits for no line queued
+// before it, which the copy it was queued with draws. Omega2DOAMStale says which engine's copy
+// is behind the OAM.
+extern u8 Omega2DOAM[2][1024];
+extern bool Omega2DOAMStale[2];
