+// omega-zero: Omega2D, the threads the 2D engines draw on (GPU.h). The emulation queues what
+// the display does at each line (the windows' vertical edges, the line's pixels, the next
+// line's sprites, the 3D line taken, the end of VBlank) to each engine's lane, whose thread
+// does it in order. A frame is drawn in step with the emulation when its pixels are read back
+// by the game (a display capture), come from VRAM or main memory directly, or the 3D is drawn
+// by OpenGL.
+bool Omega2DThreaded = false;
+std::atomic<u32> Omega2DQueued[2];
+std::atomic<u32> Omega2DDone[2];
+thread_local u32 RenderVCount = 0;
+
+namespace
+{
+
+enum class Omega2DOp : u8 { CheckWindows, DrawScanline, DrawSprites, Take3DLine, VBlankEnd };
+
+struct Omega2DCmd
+{
+    Omega2DOp Op;
+    u16 Line;
+    u16 VCount;
+};
+
+// more than a frame's commands: the lanes are emptied at every VBlank
+constexpr u32 Omega2DRingSize = 2048;
+// the commands queued before a sleeping lane is woken: eight lines' (a line queues three)
+constexpr u32 Omega2DWakeBatch = 24;
+
+struct Omega2DLane
+{
+    Omega2DCmd Ring[Omega2DRingSize];
+    std::thread Thread;
+    std::atomic<bool> Sleeping{false};
+    // rung to wake the thread from its sleep: a futex of its own rather than a condition
+    // variable, whose signal can hang in older glibc (bug 25847), as the RG SP's does
+    std::atomic<u32> Bell{0};
+};
+
+Omega2DLane Omega2DLanes[2];
+std::atomic<bool> Omega2DQuit{false};
+
+inline void Omega2DRelax()
+{
+#if defined(__aarch64__) || defined(__arm__)
+    asm volatile("yield");
+#elif defined(__x86_64__) || defined(__i386__)
+    __builtin_ia32_pause();
+#endif
+}
+
+void Omega2DSleep(u32 lane, u32 bell)
+{
+#ifdef __linux__
+    syscall(SYS_futex, reinterpret_cast<u32*>(&Omega2DLanes[lane].Bell), FUTEX_WAIT_PRIVATE, bell,
+        nullptr, nullptr, 0);
+#else
+    (void)lane;
+    (void)bell;
+    std::this_thread::sleep_for(std::chrono::microseconds(100));
+#endif
+}
+
+void Omega2DRingBell(u32 lane)
+{
+    Omega2DLanes[lane].Bell.fetch_add(1, std::memory_order_seq_cst);
+#ifdef __linux__
+    syscall(SYS_futex, reinterpret_cast<u32*>(&Omega2DLanes[lane].Bell), FUTEX_WAKE_PRIVATE, 1,
+        nullptr, nullptr, 0);
+#endif
+}
+
+void Omega2DExec(u32 lane, const Omega2DCmd& cmd)
+{
+    RenderVCount = cmd.VCount;
+    GPU2D::Unit& unit = lane ? GPU2D_B : GPU2D_A;
+    GPU2D::Renderer2D& renderer = lane ? *GPU2D_RendererB : *GPU2D_Renderer;
+    switch (cmd.Op)
+    {
+    case Omega2DOp::CheckWindows:
+        unit.CheckWindows(cmd.VCount);
+        break;
+    case Omega2DOp::DrawScanline:
+        renderer.DrawScanline(cmd.Line, &unit);
+        break;
+    case Omega2DOp::DrawSprites:
+        renderer.DrawSprites(cmd.Line, &unit);
+        break;
+    case Omega2DOp::Take3DLine:
+        GPU3D::GetLine(cmd.Line);
+        break;
+    case Omega2DOp::VBlankEnd:
+        if (lane == 0)
+            GPU2D_Renderer->VBlankEnd(&GPU2D_A, &GPU2D_B);
+        unit.VBlankEnd();
+        break;
+    }
+}
+
+void Omega2DMain(u32 lane)
+{
+    Omega2DLane& l = Omega2DLanes[lane];
+    u32 done = Omega2DDone[lane].load(std::memory_order_relaxed);
+    for (;;)
+    {
+        // out of work, a lane spins a moment, then sleeps: spinning, the lanes would keep the 3D
+        // renderer's thread and the frontend's off the cores they need. The emulation wakes it
+        // when a batch of lines waits for it (Omega2DPush), or when it waits for the lane.
+        auto idleSince = std::chrono::steady_clock::now();
+        for (u32 spins = 1; Omega2DQueued[lane].load(std::memory_order_acquire) == done; spins++)
+        {
+            if (Omega2DQuit.load(std::memory_order_acquire))
+                return;
+            Omega2DRelax();
+            if (spins % 64 || std::chrono::steady_clock::now() - idleSince < std::chrono::microseconds(20))
+                continue;
+            const u32 bell = l.Bell.load(std::memory_order_seq_cst);
+            l.Sleeping.store(true, std::memory_order_seq_cst);
+            if (Omega2DQueued[lane].load(std::memory_order_seq_cst) == done
+                && !Omega2DQuit.load(std::memory_order_seq_cst))
+                Omega2DSleep(lane, bell);
+            l.Sleeping.store(false, std::memory_order_relaxed);
+            idleSince = std::chrono::steady_clock::now();
+        }
+        Omega2DExec(lane, l.Ring[done % Omega2DRingSize]);
+        Omega2DDone[lane].store(++done, std::memory_order_release);
+    }
+}
+
+void Omega2DPush(u32 lane, const Omega2DCmd& cmd)
+{
+    Omega2DLane& l = Omega2DLanes[lane];
+    if (!l.Thread.joinable())
+        l.Thread = std::thread(Omega2DMain, lane);
+
+    const u32 queued = Omega2DQueued[lane].load(std::memory_order_relaxed);
+    while (queued - Omega2DDone[lane].load(std::memory_order_acquire) >= Omega2DRingSize)
+        Omega2DRelax();
+    l.Ring[queued % Omega2DRingSize] = cmd;
+    Omega2DQueued[lane].store(queued + 1, std::memory_order_seq_cst);
+    // a sleeping lane is woken for a batch of lines, not each one: a wake-up is a syscall, and
+    // the lane may fall behind until something waits for it
+    if (queued + 1 - Omega2DDone[lane].load(std::memory_order_relaxed) >= Omega2DWakeBatch
+        && l.Sleeping.load(std::memory_order_seq_cst))
+        Omega2DRingBell(lane);
+}
+
+// whether this frame's 2D is drawn in step with the emulation (above)
+bool Omega2DInStep()
+{
+    return !Omega2DThreaded || GPU3D::CurrentRenderer->Accelerated
+        || (GPU2D_A.CaptureCnt & (1u << 31))
+        || ((GPU2D_A.DispCnt >> 16) & 3) >= 2;
+}
+
+void Omega2DRun(Omega2DOp op, u32 line)
+{
+    const Omega2DCmd cmd{op, (u16)line, (u16)VCount};
+    const bool both = op != Omega2DOp::Take3DLine;
+    if (Omega2DInStep())
+    {
+        Sync2D();
+        Omega2DExec(0, cmd);
+        if (both)
+            Omega2DExec(1, cmd);
+        return;
+    }
+    Omega2DPush(0, cmd);
+    if (both)
+        Omega2DPush(1, cmd);
+}
+
+}
+
+void Omega2DWait(u32 lane)
+{
+    const u32 queued = Omega2DQueued[lane].load(std::memory_order_relaxed);
+    // fewer lines than a batch may wait for a lane asleep
+    if (Omega2DLanes[lane].Sleeping.load(std::memory_order_seq_cst))
+        Omega2DRingBell(lane);
+    while (Omega2DDone[lane].load(std::memory_order_acquire) != queued)
+        Omega2DRelax();
+}
+
+void Omega2DStop()
+{
+    Sync2D();
+    Omega2DQuit.store(true, std::memory_order_seq_cst);
+    for (u32 lane = 0; lane < 2; lane++)
+    {
+        if (!Omega2DLanes[lane].Thread.joinable())
+            continue;
+        Omega2DRingBell(lane);
+        Omega2DLanes[lane].Thread.join();
+    }
+    Omega2DQuit.store(false, std::memory_order_relaxed);
+}
+
+// a process that ends with the core still loaded stops the threads first: a std::thread still
+// running when its object is destroyed ends the process with std::terminate
+struct Omega2DExitGuard
+{
+    ~Omega2DExitGuard() { Omega2DStop(); }
+} Omega2DAtExit;
