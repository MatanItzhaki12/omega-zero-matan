diff --git a/src/OmegaWatch.h b/src/OmegaWatch.h
new file mode 100644
index 0000000..e0cc64f
--- /dev/null
+++ b/src/OmegaWatch.h
@@ -0,0 +1,47 @@
+/*
+    omega-zero: which of a game's functions the ARM9 enters, for the one-screen layouts, which
+    tell a game's screens apart by the functions that drew them. After Pokemon Fulldex's
+    SsrWatch (mamesj/pokemon-fulldex, GPL-3.0).
+
+    The frontend marks the functions' first addresses in a bitmap, one bit per halfword from
+    Base to End. A jump into one (the interpreter's JumpTo) or a JIT block starting at one (the
+    dispatcher) sets its bit in Hits, which the frontend reads and clears once a frame. The JIT
+    ends a block before a watched address and does not follow a branch into one, so every entry
+    starts a block of its own. It costs a bit test a block.
+*/
+#ifndef OMEGAWATCH_H
+#define OMEGAWATCH_H
+
+#include "types.h"
+
+struct OmegaWatchState
+{
+    const u8* Bitmap = nullptr; // null: nothing watched
+    u8* Hits = nullptr;
+    u32 Base = 0, End = 0;
+
+    bool Test(u32 addr) const
+    {
+        if (!Bitmap || addr - Base >= End - Base) return false;
+        const u32 bit = (addr - Base) >> 1;
+        return Bitmap[bit >> 3] & (1 << (bit & 7));
+    }
+
+    void Hit(u32 addr)
+    {
+        const u32 bit = (addr - Base) >> 1;
+        Hits[bit >> 3] |= (u8)(1 << (bit & 7));
+    }
+};
+
+extern OmegaWatchState OmegaWatch;
+
+// Which layer drew the topmost pixel of each screen (0 the top one, 1 the touch screen) in the
+// frame drawn last: bits 0-3 BG0-BG3, 0x10 or 0x80 a sprite, 0x20 the backdrop, 0x40 the 3D
+// layer (melonDS's own flags, a pixel's top byte). The one-screen layouts leave a piece's
+// background out by them. GPU2D_Soft.cpp keeps them.
+extern u8 OmegaLayers[2][256*192];
+// The screen each 2D engine draws to (0 the top one), as GPU::AssignFramebuffers last set it.
+extern int OmegaUnitScreen[2];
+
+#endif
