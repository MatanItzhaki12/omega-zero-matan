+// omega-zero: the one-screen layouts' view of the core, by name, for a frontend that looks
+// for them (dlsym); RetroArch never does.
+// Watches the functions marked in `bitmap` (one bit per halfword from `base` to `end`), each
+// entry setting its bit in `hits`; a null bitmap watches nothing. Both stay the frontend's, and
+// must outlive the watch. The JIT's blocks already made are dropped, to be made again with
+// their ends at the watched addresses.
+extern "C" RETRO_API void omega_ds_watch(const uint8_t* bitmap, uint8_t* hits, uint32_t base, uint32_t end)
+{
+   OmegaWatch.Bitmap = nullptr;
+   OmegaWatch.Hits = hits;
+   OmegaWatch.Base = base;
+   OmegaWatch.End = end;
+   OmegaWatch.Bitmap = bitmap && hits && end > base ? bitmap : nullptr;
+#ifdef JIT_ENABLED
+   if (Config::JIT_Enable)
+      ARMJIT::ResetBlockCache();
+#endif
+}
+
+// Which layer drew each pixel of `screen` (0 the top one, 1 the touch screen) in the frame
+// drawn last, 256 x 192 bytes (GPU2D_Soft.cpp, OmegaLayers).
+extern "C" RETRO_API const uint8_t* omega_ds_layers(unsigned screen)
+{
+   return OmegaLayers[screen & 1];
+}
