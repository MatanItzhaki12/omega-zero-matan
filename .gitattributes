# Every text file is LF, in the repository and in every checkout, a Windows one included: the
# card's scripts run on the handheld's shell, which takes a CR for part of a command, and the
# sources stay byte for byte what the tests and the release built.
* text=auto eol=lf

# Pictures, fonts, libraries and archives are bytes, never text.
*.png binary
*.bmp binary
*.jpg binary
*.ttf binary
*.otf binary
*.so binary
*.zip binary
*.bin binary

# Core patches are applied to a source tree byte for byte, so git must not touch their line
# endings: a hunk whose context lines were normalised on checkout no longer matches the file
# it patches, and a core that ships any source with CRLF would stop applying.
cores/**/*.patch -text
